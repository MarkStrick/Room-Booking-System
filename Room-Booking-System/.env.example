# Server-only configuration. Copy to .env or your hosting secret manager.
# Never prefix database, Google secret or SMTP credentials with VITE_.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=
APP_ORIGIN=https://rooms.example.edu
DB_DRIVER=postgres
DATABASE_URL=
# Optional absolute path to the Supabase CA certificate if required by your host.
DATABASE_CA_PATH=
# Vercel: paste the trusted Supabase PEM certificate here (literal \n accepted).
# Leave DATABASE_CA_PATH empty on Vercel. Never disable TLS verification.
DATABASE_CA_PEM=
DEV_LOGIN=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only verified university Google Workspace accounts are allowed.
ALLOWED_GOOGLE_DOMAINS=kkumail.com,kku.ac.th
ALLOW_PUBLIC_GOOGLE=0
# Verified email(s) for initial administrators; remove after initial enrollment.
BOOTSTRAP_ADMIN_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Vercel: independent random secrets, at least 32 characters each. Server only.
CRON_SECRET=
RATE_LIMIT_SECRET=
